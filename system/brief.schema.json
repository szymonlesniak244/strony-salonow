{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brief salonu (wersja 1)",
  "description": "Dane od klienta, z których fabryka stron buduje stronę. Plik brief.json każdego klienta musi spełniać ten schemat.",
  "type": "object",
  "additionalProperties": false,
  "required": ["wersja_briefu", "firma", "marka", "uslugi", "rezerwacje", "seo", "zgody"],
  "properties": {
    "$schema": { "type": "string" },
    "wersja_briefu": { "const": 1 },
    "tryb": { "enum": ["produkcyjny", "testowy"], "description": "testowy = strona demonstracyjna (noindex, dopisek w stopce)" },
    "data_wypelnienia": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pakiet": {
      "enum": ["jednostronicowy", "wielostronicowy"],
      "default": "jednostronicowy",
      "description": "jednostronicowy = wszystkie sekcje na jednej stronie; wielostronicowy = strona główna plus osobne podstrony (usługi, o nas, galeria, rezerwacja, kontakt)"
    },
    "kontakt_do_projektu": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "imie": { "type": "string" },
        "telefon": { "type": "string" },
        "email": { "type": "string" },
        "preferowany_kontakt": { "enum": ["telefon", "email", "sms", "komunikator"] }
      }
    },
    "firma": {
      "type": "object", "additionalProperties": false,
      "required": ["nazwa", "typ", "adres", "telefon", "email", "godziny"],
      "properties": {
        "nazwa": { "type": "string", "minLength": 2 },
        "typ": { "enum": ["barber", "fryzjer", "kosmetyka", "paznokcie", "brwi_rzesy", "inne"] },
        "adres": {
          "type": "object", "additionalProperties": false,
          "required": ["ulica", "kod", "miasto"],
          "properties": {
            "ulica": { "type": "string", "minLength": 2 },
            "kod": { "type": "string", "pattern": "^\\d{2}-\\d{3}$" },
            "miasto": { "type": "string", "minLength": 2 },
            "wskazowki_dojazdu": { "type": "string" }
          }
        },
        "telefon": { "type": "string", "minLength": 7 },
        "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+$" },
        "domena": { "type": "string", "description": "docelowy adres strony, np. https://salon.pl" },
        "domena_wybor": {
          "type": "object", "additionalProperties": false,
          "required": ["rodzaj"],
          "description": "życzenie klienta z ankiety; po zakupie i podpięciu wpisz adres w firma.domena",
          "properties": {
            "rodzaj": { "enum": ["kupic_nowa", "mam_domene", "bez_domeny"], "description": "bez_domeny = wystarczy darmowy adres <slug>.workers.dev" },
            "nazwa": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$", "description": "wybrana domena, np. salonlawenda.pl" },
            "zapasowe": { "type": "array", "items": { "type": "string" }, "description": "inne domeny, gdyby wybrana była zajęta" }
          }
        },
        "godziny": {
          "type": "object", "additionalProperties": false,
          "required": ["pn", "wt", "sr", "cz", "pt", "sb", "nd"],
          "properties": {
            "pn": { "$ref": "#/definitions/godziny_dnia" },
            "wt": { "$ref": "#/definitions/godziny_dnia" },
            "sr": { "$ref": "#/definitions/godziny_dnia" },
            "cz": { "$ref": "#/definitions/godziny_dnia" },
            "pt": { "$ref": "#/definitions/godziny_dnia" },
            "sb": { "$ref": "#/definitions/godziny_dnia" },
            "nd": { "$ref": "#/definitions/godziny_dnia" }
          }
        },
        "social": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "instagram": { "type": "string" },
            "facebook": { "type": "string" },
            "tiktok": { "type": "string" }
          }
        },
        "rok_zalozenia": { "type": "integer", "minimum": 1950, "maximum": 2100 }
      }
    },
    "marka": {
      "type": "object", "additionalProperties": false,
      "required": ["styl"],
      "properties": {
        "slogan": { "type": "string", "maxLength": 80 },
        "opis_krotki": { "type": "string", "maxLength": 240 },
        "opis_dlugi": { "type": "string" },
        "styl": { "enum": ["ciemny", "jasny", "pastelowy", "klasyczny"] },
        "kolor_glowny": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "kolor_akcent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "ton_komunikacji": { "type": "string" },
        "logo": { "type": "string", "description": "nazwa pliku w assets/" },
        "podobajace_sie_strony": { "type": "array", "items": { "type": "string" } }
      }
    },
    "uslugi": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kategoria", "pozycje"],
        "properties": {
          "kategoria": { "type": "string", "minLength": 2 },
          "pozycje": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["nazwa", "czas_min", "cena"],
              "properties": {
                "nazwa": { "type": "string", "minLength": 2 },
                "czas_min": { "type": "integer", "minimum": 5, "maximum": 600 },
                "cena": { "type": "number", "minimum": 0 },
                "cena_od": { "type": "boolean" },
                "opis": { "type": "string", "maxLength": 200 }
              }
            }
          }
        }
      }
    },
    "zespol": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["imie"],
        "properties": {
          "imie": { "type": "string", "minLength": 2 },
          "rola": { "type": "string" },
          "opis": { "type": "string", "maxLength": 300 },
          "zdjecie": { "type": "string" },
          "uslugi": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "galeria": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["plik", "alt"],
        "properties": { "plik": { "type": "string" }, "alt": { "type": "string", "minLength": 3 } }
      }
    },
    "opinie": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tekst", "autor", "zgoda_na_publikacje"],
        "properties": {
          "tekst": { "type": "string", "minLength": 5 },
          "autor": { "type": "string" },
          "zrodlo": { "type": "string" },
          "zgoda_na_publikacje": { "type": "boolean" }
        }
      }
    },
    "rezerwacje": {
      "type": "object", "additionalProperties": false,
      "required": ["chce_rezerwacje_online"],
      "properties": {
        "chce_rezerwacje_online": { "type": "boolean" },
        "aktualny_system": { "enum": ["brak", "booksy", "versum", "fresha", "simplybook", "inny"] },
        "link_do_rezerwacji": { "type": "string" },
        "widget_kod": { "type": "string", "description": "kod widżetu rezerwacji (wklejany przez agencję)" },
        "zasady_odwolania_godzin": { "type": "integer", "minimum": 0, "maximum": 168 },
        "minimalne_wyprzedzenie_godzin": { "type": "integer", "minimum": 0, "maximum": 168 },
        "godziny_startu_co": {
          "enum": ["dlugosc_uslugi", "15_min", "30_min", "60_min"],
          "default": "dlugosc_uslugi",
          "description": "co ile pokazywać wolne godziny rozpoczęcia wizyty; dlugosc_uslugi = co długość usługi plus bufor (opcja bazowa)"
        },
        "bufor_po_usludze_minut": {
          "type": "integer", "minimum": 0, "maximum": 120, "default": 0,
          "description": "przerwa po każdej wizycie (np. sprzątanie stanowiska), wliczana do odstępu przy opcji dlugosc_uslugi"
        },
        "zadatek": {
          "type": "object", "additionalProperties": false,
          "required": ["chce"],
          "properties": {
            "chce": { "type": "boolean" },
            "tryb": { "enum": ["stala", "procent"] },
            "kwota": { "type": "number", "minimum": 0 },
            "procent": { "type": "number", "minimum": 0, "maximum": 100 },
            "dotyczy_kategorii": { "type": "array", "items": { "type": "string" } },
            "zasady_zwrotu": { "type": "string" }
          }
        },
        "przypomnienia": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "sms": { "type": "boolean" },
            "email": { "type": "boolean" },
            "godziny_przed": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 168 } }
          }
        },
        "prosba_o_opinie": {
          "type": "object", "additionalProperties": false,
          "required": ["chce"],
          "description": "e-mail z SimplyBook z prośbą o opinię po wizycie",
          "properties": {
            "chce": { "type": "boolean", "default": true },
            "dni_po_wizycie": { "type": "integer", "minimum": 1, "maximum": 30, "default": 1 }
          }
        }
      }
    },
    "seo": {
      "type": "object", "additionalProperties": false,
      "required": ["miasto"],
      "properties": {
        "miasto": { "type": "string", "minLength": 2 },
        "dzielnica": { "type": "string" },
        "slowa_kluczowe": { "type": "array", "items": { "type": "string" } },
        "profil_google_istnieje": { "type": "boolean" },
        "link_google_maps": { "type": "string" }
      }
    },
    "prawne": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "administrator_danych": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "nazwa": { "type": "string" },
            "adres": { "type": "string" },
            "email": { "type": "string" },
            "nip": { "type": "string", "pattern": "^\\d{10}$" }
          }
        },
        "regulamin_dodatkowe_zasady": { "type": "string" }
      }
    },
    "cele_i_dane": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "oczekiwania": { "type": "string" },
        "wizyt_miesiecznie": { "type": "integer", "minimum": 0 },
        "nieobecnosci_miesiecznie": { "type": "integer", "minimum": 0 },
        "srednia_cena_wizyty": { "type": "number", "minimum": 0 },
        "budzet_wdrozenia_od": { "type": "number", "minimum": 0 },
        "budzet_wdrozenia_do": { "type": "number", "minimum": 0 },
        "budzet_abonamentu_od": { "type": "number", "minimum": 0 },
        "budzet_abonamentu_do": { "type": "number", "minimum": 0 },
        "termin_uruchomienia": { "type": "string" },
        "uwagi": { "type": "string" }
      }
    },
    "zgody": {
      "type": "object", "additionalProperties": false,
      "required": ["przetwarzanie_danych_briefu", "prawa_do_zdjec"],
      "properties": {
        "przetwarzanie_danych_briefu": { "const": true },
        "prawa_do_zdjec": { "type": "boolean" },
        "zgoda_na_portfolio": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "godziny_dnia": {
      "type": "string",
      "pattern": "^(nieczynne|([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d)$"
    }
  }
}
